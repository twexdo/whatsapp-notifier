# The template body must include one text parameter.
# WHATSAPP_TEMPLATE_NAME=your_approved_template_name
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
PORT=3000
# Optional: use /var/log/journal if the host stores persistent journals there.
# JOURNAL_DIR=/run/log/journal
